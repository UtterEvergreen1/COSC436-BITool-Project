# Copy this file to .env (never commit .env). These are local-only dev values.
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=dw_password
POSTGRES_DB=trading_dw
POSTGRES_PORT=5433

# Pin Metabase to the version the team uses (Metabase > Admin > Troubleshooting
# shows it) so everyone's dashboards open on the same version.
# Example: METABASE_VERSION=v0.52.4   (leave as latest only until the team agrees)
METABASE_VERSION=latest
METABASE_PORT=3000
